{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node tools/fetch-pack.mjs && node web/build.mjs --refresh",
  "outputDirectory": "web/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "github": {
    "silent": true
  },
  "headers": [
    {
      "source": "/ask/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "functions": {
    "api/ask.mjs": {
      "includeFiles": "{world/policy.json,bench/fixtures/wiki/pack-200/**,neo/know/**,grown/**}",
      "maxDuration": 60
    }
  },
  "ignoreCommand": "test -f tools/fetch-pack.mjs && exit 1; exit 0"
}
