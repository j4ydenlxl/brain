{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/reorient.mjs PostCompact",
            "timeout": 30,
            "statusMessage": "Reading the BRAIN manual"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/reorient.mjs SessionStart",
            "timeout": 30,
            "statusMessage": "Reading the BRAIN manual"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "Agent",
      "Workflow",
      "Monitor",
      "TaskStop",
      "ToolSearch",
      "Skill"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)",
      "Read(./state/**)"
    ]
  }
}
