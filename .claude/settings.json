{
  "hooks": {
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/reorient.mjs PostCompact",
            "timeout": 30,
            "statusMessage": "Reading the BRAIN manual"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/reorient.mjs SessionStart",
            "timeout": 30,
            "statusMessage": "Reading the BRAIN manual"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "MultiEdit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "Agent",
      "Workflow",
      "Monitor",
      "TaskStop",
      "ToolSearch",
      "Skill",
      "WebFetch",
      "WebSearch",
      "ScheduleWakeup",
      "CronCreate",
      "CronList",
      "CronDelete",
      "SendMessage",
      "ListAgents",
      "Artifact",
      "ArtifactData",
      "ArtifactComments",
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "ReadNotifications",
      "PushNotification",
      "SuggestSkills",
      "ReportFindings"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)",
      "Read(./state/**)"
    ],
    "defaultMode": "bypassPermissions"
  }
}
